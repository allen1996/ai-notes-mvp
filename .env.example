# Add fictional demo meetings on a new database. Set false for an empty workspace.
SEED_DEMO=true
# Can be set as 'mock' or 'assemblyai'
AI_PROVIDER=mock
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_LLM_MODEL=claude-sonnet-4-5-20250929
# Clerk: get both DEVELOPMENT keys from your existing app's API keys page.
# The publishable key is public and bundled into React; the secret is backend-only.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Hosting: Railway supplies PORT and RAILWAY_VOLUME_MOUNT_PATH automatically.
# Production uses NODE_ENV=production; APP_ORIGIN can default to Railway's public domain.
# APP_ORIGIN=https://your-service.up.railway.app
# DATA_DIR=/data
# Can be set as 'local' or 'r2'.
AUDIO_STORAGE=local

# Optional private Cloudflare R2 storage for new recordings (AUDIO_STORAGE=r2).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

